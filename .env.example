# Optional. Required only for requests routed to the Google Gen AI API.
# Keep real API keys in your local .env file or deployment secret store.
GEMINI_API_KEY=""

# Model identifier used by the Google Gen AI SDK.
# Defaults to gemma-4-26b-a4b-it when omitted.
GEMMA_MODEL_ID="gemma-4-26b-a4b-it"

# Optional. Defaults to 3000.
PORT="3000"

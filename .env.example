# GEMINI_API_KEY: Required for Google Gemini API and Gemma 4 open-weights inference.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# GEMMA_MODEL_ID: Model identifier for Gemma 4 via Google Gen AI SDK.
# Default target: gemma-4-26b-a4b-it
GEMMA_MODEL_ID="gemma-4-26b-a4b-it"

# Application Port
PORT="3000"
